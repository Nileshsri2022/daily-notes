{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "REACT_NATIVE_ARCHITECTURES": "arm64-v8a"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "REACT_NATIVE_ARCHITECTURES": "arm64-v8a"
      }
    }
  }
}
