{
  "expo": {
    "name": "Dincharya",
    "slug": "dincharya",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dincharya",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.nilesh.dincharya",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Dincharya to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow Dincharya to use the microphone."
      }
    },
    "android": {
      "package": "com.nilesh.dincharya",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Dincharya to pick a cover photo."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Dincharya to use the microphone.",
          "speechRecognitionPermission": "Allow Dincharya to use speech recognition."
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92644a74-f8f7-4a9f-9347-929b22ae01c8"
      }
    }
  }
}
