# Clerk — paste your publishable key from https://dashboard.clerk.com
# (your app -> API Keys -> Publishable Key, looks like pk_test_xxxx)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_aGVscGVkLWJlYWdsZS03NzU2LmNsZXJrLmFjY291bnRzLmRldiQ

# Convex — this line is written automatically for you by `npx convex dev`
# after you log in and create a project. Uncomment/replace if needed:
# EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
